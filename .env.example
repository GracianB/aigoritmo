# Aigoritmo local settings (copy to .env — never commit real keys)
# Leave blank / omit XAI_API_KEY to stay on local Ollama.
# Tomorrow (API day): put XAI_API_KEY in .env; Arcana/Arcano preferred_provider=spacexai kicks in.
# Or force everyone: LLM_PROVIDER=spacexai (or FORCE_LLM_PROVIDER=spacexai).

# Optional global LLM override (empty = resolve from avatar YAML)
# LLM_PROVIDER=
# FORCE_LLM_PROVIDER=

# Local Ollama (default when no key / no override)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180

# xAI / SpaceXAI (OpenAI-compatible). Do not paste secrets into chat.
# XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_VISION_MODEL=grok-4.5

HOST=127.0.0.1
PORT=8000
DEFAULT_AVATAR=arcana
