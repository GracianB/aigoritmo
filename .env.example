# Aigoritmo local settings (copy to .env — never commit real keys)
#
# Three ways to run chat tomorrow:
#   1) Ollama (default): no cloud keys → avatar.llm.provider (ollama).
#   2) Grok / xAI: set XAI_API_KEY → Arcana/Arcano preferred_provider=spacexai kicks in.
#   3) ChatGPT / OpenAI: set OPENAI_API_KEY and LLM_PROVIDER=openai (overrides preferred).
# Or force everyone: LLM_PROVIDER=spacexai|openai|ollama (or FORCE_LLM_PROVIDER=...).

# Optional global LLM override (empty = resolve from avatar YAML)
# LLM_PROVIDER=
# FORCE_LLM_PROVIDER=

# Local Ollama (default when no key / no override)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180

# xAI / SpaceXAI / Grok (OpenAI-compatible). Do not paste secrets into chat.
# XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_VISION_MODEL=grok-4.5

# OpenAI / ChatGPT. Quality default gpt-4.1; cheaper: OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1

HOST=127.0.0.1
PORT=8000
DEFAULT_AVATAR=arcana
